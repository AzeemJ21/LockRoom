# MongoDB — Used ONLY for room metadata (no messages ever stored)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dbname?retryWrites=true&w=majority

# If you see querySrv ECONNREFUSED / Atlas SRV DNS errors, either set public DNS for Node only:
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
# …or use Atlas "standard connection string" (mongodb://host:27017,…) instead of mongodb+srv://

# Redis — Ephemeral session data, auto-expires
REDIS_URL=redis://localhost:6379

# Socket.IO (same origin as the web app when using `npm run dev`)
PORT=3000

# If Atlas hangs on Windows, try: MONGODB_FORCE_IPV4=1
# MONGODB_FORCE_IPV4=1

NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# STUN (public). For TURN, prefer short-lived credentials minted server-side — never ship long-lived secrets to browsers.
NEXT_PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional: safe-to-expose TURN URLs when using providers that issue ephemeral credentials client-side.
# NEXT_PUBLIC_TURN_URLS=
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# Server-only TURN configuration (do NOT expose to the browser — use token minting in production)
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Security
ROOM_INACTIVITY_TIMEOUT_MS=60000
MAX_FILE_SIZE_MB=25
MAX_PARTICIPANTS_PER_ROOM=10
NEXT_PUBLIC_MAX_FILE_SIZE_MB=25
